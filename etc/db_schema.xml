<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="ict_exitintent_guest_coupon_usage"
           resource="default"
           engine="innodb"
           comment="Exit Intent Popup — coupon redemption records for guest orders">

        <column xsi:type="int"       name="entity_id" unsigned="true"  nullable="false" identity="true"  comment="Primary Key"/>
        <column xsi:type="varchar"   name="email"     length="255"     nullable="false"                  comment="Guest customer email"/>
        <column xsi:type="int"       name="rule_id"   unsigned="true"  nullable="false" identity="false" comment="SalesRule Rule ID"/>
        <column xsi:type="int"       name="order_id"  unsigned="true"  nullable="false" identity="false" comment="Sales Order Entity ID"/>
        <column xsi:type="timestamp" name="used_at"   nullable="false" default="CURRENT_TIMESTAMP"       comment="Order placement timestamp"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>

        <constraint xsi:type="unique" referenceId="ICT_EXITINTENT_GUEST_COUPON_USAGE_EMAIL_RULE_ID">
            <column name="email"/>
            <column name="rule_id"/>
        </constraint>
    </table>
</schema>
