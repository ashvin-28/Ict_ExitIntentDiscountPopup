<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="ict_exitintent_coupon_copied"
           resource="default"
           engine="innodb"
           comment="Exit Intent Popup — coupon codes copied by logged-in customers">

        <column xsi:type="int"       name="id"          unsigned="true" nullable="false" identity="true" comment="Primary Key"/>
        <column xsi:type="int"       name="customer_id"  unsigned="true" nullable="false" identity="false" comment="Customer Entity ID"/>
        <column xsi:type="int"       name="rule_id"      unsigned="true" nullable="false" identity="false" comment="SalesRule Rule ID"/>
        <column xsi:type="timestamp" name="copied_at"    nullable="false" default="CURRENT_TIMESTAMP"      comment="Timestamp of copy action"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>

        <!-- One record per customer+rule — prevents duplicate inserts -->
        <constraint xsi:type="unique" referenceId="ICT_EXITINTENT_COUPON_COPIED_CUSTOMER_RULE">
            <column name="customer_id"/>
            <column name="rule_id"/>
        </constraint>

        <index referenceId="ICT_EXITINTENT_COUPON_COPIED_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>
</schema>
